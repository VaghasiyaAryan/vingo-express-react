# Copy to client/.env if you need to change either of these. Both have working
# defaults, so the file is optional.
#
# Only variables prefixed VITE_ reach the browser — and everything that reaches
# the browser is public. Never put a secret in this file.

# Where `npm run dev` proxies /api, /sitemap.xml and /robots.txt.
# Must match the Express server's PORT.
VITE_API_TARGET=http://localhost:4000

# Canonical site URL, used for the WhatsApp/email deep links and the catalogue
# link the client renders. The server has its own SITE_URL for the tags it
# injects into <head> — set both to the same value.
VITE_SITE_URL=https://www.vingointernational.com

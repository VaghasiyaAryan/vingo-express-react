# The server loads, in order, each file that exists:
#
#   ../.env        the repo-root file the Next.js build already uses
#   ../.env.local  local overrides
#   ./.env         this package, for anything you want to set for the API only
#
# Later files win, which is the same precedence Next.js applies — so an
# existing setup keeps working with no changes, and this file is optional.

# ---------------------------------------------------------------- required
# Postgres connection string (Neon, or any Postgres).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Password for the /admin dashboard. Also the HMAC key that signs admin
# session cookies — changing it signs every existing session out.
ADMIN_PASSWORD=change-me

# ---------------------------------------------------------------- optional
# Port the API listens on. The Vite dev server proxies to this.
PORT=4000

# Canonical production URL. Every canonical link, Open Graph tag, JSON-LD URL
# and the sitemap derives from this. NEXT_PUBLIC_SITE_URL is accepted as a
# legacy alias so an existing root .env keeps working unchanged.
SITE_URL=https://www.vingointernational.com

# Email alerts for new enquiries, and admin "Reply" — sent via Resend's API.
# The enquiry form works without these; replies do not.
RESEND_API_KEY=
RESEND_FROM=hello@vingointernational.com
INQUIRY_NOTIFY_TO=hello@vingointernational.com

# Where the built React app lives. Defaults to ../client/dist.
CLIENT_DIST=

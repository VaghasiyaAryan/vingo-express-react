{
  "name": "vingo-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express API and SEO-aware static host for the VinGo International website.",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env --env-file-if-exists=../.env.local --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=../.env --env-file-if-exists=../.env.local --env-file-if-exists=.env src/index.js",
    "seed": "node --env-file-if-exists=../.env --env-file-if-exists=../.env.local --env-file-if-exists=.env scripts/seed.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/adapter-neon": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^4.6.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "prisma": "^5.22.0",
    "react": "^19.0.0",
    "resend": "^6.21.0",
    "ws": "^8.18.0"
  }
}

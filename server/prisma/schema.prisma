datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  // GoDaddy builds on a Debian image but runs on Alpine/musl with only
  // OpenSSL 3, so the runtime engine has to be bundled explicitly.
  // `native` covers local development.
  binaryTargets   = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl-openssl-3.0.x"]
  // GoDaddy's network blocks outbound TCP on 5432. The Neon driver adapter
  // (see src/prisma.js) sends queries over WebSockets on port 443 instead.
  previewFeatures = ["driverAdapters"]
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUOTED
  CLOSED
}

model Inquiry {
  id              String        @id @default(cuid())
  name            String
  email           String
  phone           String
  company         String?
  country         String?
  productInterest String?
  quantity        String?
  message         String
  status          InquiryStatus @default(NEW)
  createdAt       DateTime      @default(now())

  @@index([createdAt])
  @@index([status])
}

// Brute-force protection for /admin/login. DB-backed (not in-memory) because
// the API may restart or run as more than one process.
model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  category     String
  name         String
  image        String?
  form         String   @default("flakes")
  colors       Json
  short        String
  description  String
  forms        String[]
  applications String[]
  specs        Json
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([active])
}

enum AdminRole {
  OWNER // everything, including adding and removing admins
  EDITOR // everything except managing admins
}

// A person who can sign in to the admin panel. Passwords are stored only as
// salted scrypt hashes. Until the first row exists, the shared ADMIN_PASSWORD
// signs in instead (see src/auth.js).
model AdminUser {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  role              AdminRole @default(EDITOR)
  passwordHash      String
  passwordSalt      String
  passwordChangedAt DateTime  @default(now())
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// Who did what in the admin panel: every change, plus sign-ins (including
// failed ones) and sign-outs. Never stores passwords or request bodies — only
// a short human-readable detail such as the product name.
model AdminAuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  adminId   String? // null for the shared password or a failed sign-in
  actor     String // name/email of who acted (or the email tried, on a failed sign-in)
  action    String // e.g. "Edited product"
  detail    String? // e.g. "Dehydrated Mango"
  target    String? // the record id acted on, when there is one
  status    Int // HTTP status of the result: 2xx succeeded, 4xx refused
  ip        String

  @@index([createdAt])
}

// Small pieces of website text editable from the admin panel, one row per
// key (e.g. "heroFloatingLabels"). A missing row means "use the default from
// shared/content.js".
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// A product photo uploaded from the admin panel, served at /api/images/:id.
// Kept in Postgres rather than on disk because GoDaddy's app containers are
// rebuilt on every deploy — files written next to the app would vanish.
model Image {
  id          String   @id @default(cuid())
  contentType String
  sizeBytes   Int
  data        Bytes
  createdAt   DateTime @default(now())
}

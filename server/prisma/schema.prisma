datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUOTED
  CLOSED
}

model Inquiry {
  id              String        @id @default(cuid())
  name            String
  email           String
  phone           String
  company         String?
  country         String?
  productInterest String?
  quantity        String?
  message         String
  status          InquiryStatus @default(NEW)
  createdAt       DateTime      @default(now())

  @@index([createdAt])
  @@index([status])
}

// Brute-force protection for /admin/login. DB-backed (not in-memory) because
// Vercel serverless functions don't share memory across cold starts.
model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  category     String
  name         String
  image        String?
  form         String   @default("flakes")
  colors       Json
  short        String
  description  String
  forms        String[]
  applications String[]
  specs        Json
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([active])
}

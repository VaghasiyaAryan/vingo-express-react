datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  // Confirmed from GoDaddy's actual runtime crash log (not guessed): the
  // container is Alpine/musl, and it tried `libquery_engine-linux-musl.so.node`
  // (implicitly the openssl-1.1.x build) which failed — "Error loading shared
  // library libssl.so.1.1: No such file or directory" — because this Alpine
  // image only has OpenSSL 3.x. The build container is a *different* base
  // image (Debian-ish, going by "native" resolving fine there during
  // `prisma generate`), so build-time success alone never caught this.
  // linux-musl-openssl-3.0.x is the one that actually matches production;
  // the debian-* targets stay in case the build container itself ever runs
  // the generated client directly, and native covers local dev.
  binaryTargets   = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl-openssl-3.0.x"]
  // GoDaddy's hosting network blocks outbound TCP on 5432 (raw Postgres wire
  // protocol) — confirmed via runtime logs: "Can't reach database server"
  // while the same connection string worked fine from every other network
  // tested. Driver adapters let Prisma run queries over Neon's HTTPS/WS
  // endpoint instead (see server/src/prisma.js), which only needs port 443.
  previewFeatures = ["driverAdapters"]
}

// An admin account. The first row is bootstrapped lazily from ADMIN_PASSWORD
// (and, if set, ADMIN_USERNAME / ADMIN_EMAIL) the first time it's needed —
// after that it's just a normal row, editable from /admin/settings. Further
// admins are created from /admin/admins, confirmed via a one-time code
// emailed to the creating admin (see AdminInvite). See server/src/auth.js.
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String?  @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// A pending "create new admin" request awaiting OTP confirmation from the
// admin who initiated it (see server/src/routes/admin/admins.js). Short-lived
// by design — rows are deleted on confirm, expiry, or being superseded by a
// newer request from the same admin — so this intentionally isn't tied to
// AdminUser with a foreign key.
model AdminInvite {
  id            String   @id @default(cuid())
  requestedById String
  username      String
  email         String
  passwordHash  String
  otpHash       String
  otpExpiresAt  DateTime
  attempts      Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([requestedById])
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUOTED
  CLOSED
}

model Inquiry {
  id              String        @id @default(cuid())
  name            String
  email           String
  phone           String
  company         String?
  country         String?
  productInterest String?
  quantity        String?
  message         String
  status          InquiryStatus @default(NEW)
  createdAt       DateTime      @default(now())

  @@index([createdAt])
  @@index([status])
}

// Brute-force protection for /admin/login. DB-backed (not in-memory) because
// Vercel serverless functions don't share memory across cold starts.
model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

// Singleton row (fixed id) holding the admin's uploaded catalogue PDF, if any.
// Falls back to the auto-generated catalogue (see /api/catalog) when absent.
model CatalogFile {
  id         String   @id @default("catalog")
  url        String
  filename   String
  sizeBytes  Int
  uploadedAt DateTime @default(now())
}

// A person on the Team page. `featured` puts them in the large leader card
// at the top; everyone else renders in the grid below, ordered by sortOrder.
model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String
  photo     String?
  featured  Boolean  @default(false)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  category     String
  name         String
  image        String?
  // Certificate of Analysis — a lab report/spec sheet PDF (or scanned image)
  // for this batch/product, uploaded from /admin/products. Shown as a
  // "Download COA" button on the public site only when set.
  coaUrl       String?
  form         String   @default("flakes")
  colors       Json
  short        String
  description  String
  forms        String[]
  applications String[]
  specs        Json
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([active])
}

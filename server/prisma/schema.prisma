datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  // GoDaddy builds on a Debian image but runs on Alpine/musl with only
  // OpenSSL 3, so the runtime engine has to be bundled explicitly.
  // `native` covers local development.
  binaryTargets   = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl-openssl-3.0.x"]
  // GoDaddy's network blocks outbound TCP on 5432. The Neon driver adapter
  // (see src/prisma.js) sends queries over WebSockets on port 443 instead.
  previewFeatures = ["driverAdapters"]
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUOTED
  CLOSED
}

model Inquiry {
  id              String        @id @default(cuid())
  name            String
  email           String
  phone           String
  company         String?
  country         String?
  productInterest String?
  quantity        String?
  message         String
  status          InquiryStatus @default(NEW)
  createdAt       DateTime      @default(now())

  @@index([createdAt])
  @@index([status])
}

// Brute-force protection for /admin/login. DB-backed (not in-memory) because
// the API may restart or run as more than one process.
model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  category     String
  name         String
  image        String?
  form         String   @default("flakes")
  colors       Json
  short        String
  description  String
  forms        String[]
  applications String[]
  specs        Json
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([active])
}

// A product photo uploaded from the admin panel, served at /api/images/:id.
// Kept in Postgres rather than on disk because GoDaddy's app containers are
// rebuilt on every deploy — files written next to the app would vanish.
model Image {
  id          String   @id @default(cuid())
  contentType String
  sizeBytes   Int
  data        Bytes
  createdAt   DateTime @default(now())
}
